# Provide one of the following:
GENAI_TOKEN=
KEYSTORE_PATH=

# If you enable KEYSTORE_PATH above, uncomment the volume in docker-compose.yml
# and use this in-container path:
# KEYSTORE_PATH=/app/docker-deploy.keystore

APP_PORT=5000
PROXY_API_KEY=
APP_DEBUG=0
# Optional Docker build metadata override for source archives without .git.
# GENAI_BUILD_COMMIT=
# GENAI_BUILD_COMMIT_TIME=
# GENAI_BUILD_DIRTY=0
TOKEN_CHECK_INTERVAL=60
GENAI_MAX_RETRIES=10
GENAI_RETRY_BACKOFF=0.5
# Persistent last-known-good model catalog used when the upstream list fails.
# GENAI_MODEL_CACHE=/app/.cache/models/models.json
# Optional persistent directory for verified Hugging Face tokenizer artifacts.
# GENAI_TOKENIZER_CACHE=/app/.cache/tokenizers

CLAUDE_HAIKU_MODEL=deepseek-chat
CLAUDE_SONNET_MODEL=chatglm
CLAUDE_OPUS_MODEL=chatglm
